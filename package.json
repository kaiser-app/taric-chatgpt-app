:root { color: #16324f; background: #f5f8fa; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
* { box-sizing: border-box; }
body { margin: 0; }
.shell { max-width: 1120px; margin: 0 auto; padding: 32px 20px; }
.hero { background: #fff; border: 1px solid #d3dde6; border-left: 8px solid #16324f; padding: 28px; margin-bottom: 20px; box-shadow: 0 10px 25px rgba(22,50,79,.06); }
.eyebrow { text-transform: uppercase; letter-spacing: .12em; font-size: 12px; color: #2e5e8c; font-weight: 700; }
h1 { margin: 0; font-size: 42px; }
.grid { display: grid; grid-template-columns: 420px 1fr; gap: 20px; align-items: start; }
.card { background: #fff; border: 1px solid #d3dde6; padding: 22px; box-shadow: 0 10px 25px rgba(22,50,79,.06); }
label { display: block; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 14px; }
input, textarea, select { display: block; width: 100%; margin-top: 6px; border: 1px solid #d3dde6; border-radius: 8px; padding: 10px 12px; font: inherit; color: #16324f; }
textarea { min-height: 92px; resize: vertical; }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.check { display: flex; gap: 10px; align-items: center; text-transform: none; letter-spacing: 0; font-size: 14px; }
.check input { width: auto; margin: 0; }
button { width: 100%; border: 0; border-radius: 10px; background: #16324f; color: white; padding: 13px 16px; font-weight: 800; cursor: pointer; }
button:disabled { opacity: .6; cursor: progress; }
.error { color: #b03a3a; font-weight: 700; }
.muted { color: #6b7c8f; }
.badge { display: inline-block; background: #eaf4ef; border: 1px solid #2f7d5c; color: #2f7d5c; padding: 4px 9px; border-radius: 999px; font-size: 12px; font-weight: 800; text-transform: uppercase; }
h2 { font-size: 34px; margin: 10px 0 6px; }
dl { display: grid; grid-template-columns: 160px 1fr; gap: 8px 14px; border-top: 1px solid #d3dde6; border-bottom: 1px solid #d3dde6; padding: 14px 0; }
dt { font-weight: 800; } dd { margin: 0; }
pre { white-space: pre-wrap; overflow: auto; background: #f5f8fa; border: 1px solid #d3dde6; padding: 14px; border-radius: 8px; font-size: 12px; }
@media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .row { grid-template-columns: 1fr; } }
